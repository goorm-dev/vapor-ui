{
    "name": "@vapor-ui/composites",
    "version": "0.0.0",
    "description": "",
    "keywords": [
        "react",
        "react-components",
        "ui",
        "design-system",
        "accessible"
    ],
    "homepage": "https://github.com/goorm-dev/vapor-ui",
    "bugs": {
        "url": "https://github.com/goorm-dev/vapor-ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goorm-dev/vapor-ui.git",
        "directory": "packages/composites"
    },
    "license": "MIT",
    "author": "Vapor Team <vapor.ui@goorm.io>",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./*": {
            "import": {
                "types": "./dist/components/*/index.d.mts",
                "default": "./dist/components/*/index.mjs"
            },
            "require": {
                "types": "./dist/components/*/index.d.cts",
                "default": "./dist/components/*/index.cjs"
            }
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rimraf dist && rolldown -c rolldown.config.ts",
        "clean": "rimraf dist node_modules .turbo",
        "figma:gen": "node --env-file-if-exists=.env ./scripts/gen-code-connect/cli.mjs",
        "lint": "eslint ./src",
        "test": "vitest --run --passWithNoTests",
        "test:coverage": "vitest --coverage --passWithNoTests",
        "test:regressions": "playwright test -c ./playwright.config.ts",
        "test:watch": "vitest --passWithNoTests",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/utils": "^0.3.2",
        "@vapor-ui/icons": "workspace:^",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@figma/code-connect": "^2.0.0",
        "@playwright/test": "^1.62.1",
        "@repo/eslint-config": "workspace:^",
        "@repo/rolldown-config": "workspace:^",
        "@repo/typescript-config": "workspace:^",
        "@storybook/react-vite": "9.1.20",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^22.19.20",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vapor-ui/core": "workspace:^",
        "@vitest/browser": "^3.2.7",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "catalog:",
        "happy-dom": "^20.9.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rimraf": "^6.1.3",
        "rolldown": "^1.1.4",
        "tinyglobby": "^0.2.17",
        "typescript": "catalog:",
        "vitest": "^3.2.7"
    },
    "peerDependencies": {
        "@vapor-ui/core": "workspace:^",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
