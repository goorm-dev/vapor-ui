{
    "name": "@vapor-ui/figma-eval",
    "version": "0.0.0",
    "description": "Grades generated vapor-ui code against a Figma design through Code Connect templates",
    "keywords": [
        "vapor-ui",
        "figma",
        "code connect",
        "eval"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goorm-dev/vapor-ui.git",
        "directory": "packages/figma-eval"
    },
    "main": "dist/index.mjs",
    "bin": {
        "figma-eval": "./dist/bin/cli.mjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist node_modules coverage .turbo",
        "dev": "tsup --watch",
        "lint": "eslint ./src",
        "test": "vitest --run --passWithNoTests",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^24.13.3",
        "eslint": "catalog:",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
