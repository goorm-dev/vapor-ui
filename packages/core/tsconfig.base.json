{
    "extends": "@repo/typescript-config/react-library",
    "compilerOptions": {
        "composite": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "~/*": ["./src/*"]
        },
        "types": ["node"]
    },
    "include": [
        "src",
        "playwright.config.ts",
        "playwright.merge.ts",
        "rolldown.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "dist",
        "build",
        "node_modules",
        "src/**/*.test.ts*",
        "src/**/*.spec.ts*",
        "__tests__"
    ]
}
