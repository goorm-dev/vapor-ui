{
    "extends": "@repo/typescript-config/react-library",
    "compilerOptions": {
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "~/*": ["./src/*"]
        },
        "types": [
            "node",
            "vitest-axe/extend-expect",
            "vitest/globals",
            "@vitest/browser/context",
            "@figma/code-connect/figma-types-no-require"
        ]
    },
    "include": ["."],
    "exclude": ["dist", "build", "node_modules"]
}
