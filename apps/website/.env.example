# TokenHub (사내 LLM 게이트웨이, OpenAI 호환) — required for `pnpm translate`.
# 인증 없음(사내망 전용): LITELLM_API_KEY는 형식상 필요할 뿐 게이트웨이가 무시한다.
# dev URL(tokenhub.dev-k8s.arkain.io)은 mock 응답만 반환 — 실제 번역은 프로덕션 URL 사용(팀 담당자 확인).
# 가이드: https://app.notion.com/p/goorm/3ab4e6997fb08017be7fe64ecd83545a
LITELLM_BASE_URL=https://tokenhub.dev-k8s.arkain.io/v1/common
LITELLM_API_KEY=unused
