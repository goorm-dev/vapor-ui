{
    "name": "NavigationMenuRoot",
    "props": [
        {
            "name": "direction",
            "type": [
                "horizontal",
                "vertical"
            ],
            "required": false
        },
        {
            "name": "size",
            "type": [
                "sm",
                "md",
                "lg",
                "xl"
            ],
            "required": false
        },
        {
            "name": "defaultValue",
            "type": [
                "unknown"
            ],
            "required": false,
            "description": "처음에 선택되어야 하는 항목의 제어되지 않는 값입니다.\n\n제어되는 내비게이션 메뉴를 렌더링하려면 `value` prop을 대신 사용합니다."
        },
        {
            "name": "onValueChange",
            "type": [
                "(value: unknown, eventDetails: NavigationMenu.Root.ChangeEventDetails) => void"
            ],
            "required": false,
            "description": "값이 변경될 때 호출되는 콜백입니다."
        },
        {
            "name": "value",
            "type": [
                "unknown"
            ],
            "required": false,
            "description": "현재 열려 있어야 하는 내비게이션 메뉴 항목의 제어되는 값입니다.\nnullish가 아니면 메뉴가 열립니다. nullish이면 메뉴가 닫힙니다.\n\n제어되지 않는 내비게이션 메뉴를 렌더링하려면 `defaultValue` prop을 대신 사용합니다."
        },
        {
            "name": "className",
            "type": [
                "string | ((state: NavigationMenu.Root.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "disabled",
            "type": [
                "boolean"
            ],
            "required": false
        },
        {
            "name": "actionsRef",
            "type": [
                "React.RefObject<NavigationMenuRootActions | null>"
            ],
            "required": false,
            "description": "명령형 액션에 대한 ref입니다."
        },
        {
            "name": "closeDelay",
            "type": [
                "number"
            ],
            "required": false,
            "description": "내비게이션 팝업을 닫기 전에 대기할 시간입니다. 밀리초 단위로 지정합니다."
        },
        {
            "name": "delay",
            "type": [
                "number"
            ],
            "required": false,
            "description": "내비게이션 팝업을 열기 전에 대기할 시간입니다. 밀리초 단위로 지정합니다."
        },
        {
            "name": "onOpenChangeComplete",
            "type": [
                "(open: boolean) => void"
            ],
            "required": false,
            "description": "내비게이션 메뉴가 닫힐 때 모든 애니메이션이 완료된 후 호출되는 이벤트 핸들러입니다."
        },
        {
            "name": "orientation",
            "type": [
                "horizontal",
                "vertical"
            ],
            "required": false,
            "description": "내비게이션 메뉴의 방향입니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: NavigationMenu.Root.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: NavigationMenu.Root.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
