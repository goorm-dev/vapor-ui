{
    "name": "Badge",
    "props": [
        {
            "name": "colorPalette",
            "type": ["primary", "success", "warning", "danger", "hint", "contrast"],
            "required": false,
            "defaultValue": "primary"
        },
        {
            "name": "shape",
            "type": ["square", "pill"],
            "required": false,
            "defaultValue": "square"
        },
        {
            "name": "size",
            "type": ["sm", "md", "lg"],
            "required": false,
            "defaultValue": "md"
        },
        {
            "name": "className",
            "type": ["string | ((state: Badge.State) => (string | undefined))"],
            "required": false,
            "description": "CSS class applied to the element, or a function that returns a class based on the component’s state."
        },
        {
            "name": "render",
            "type": ["ReactElement | ((props: HTMLProps, state: Badge.State) => ReactElement)"],
            "required": false,
            "description": "Allows you to replace the component's HTML element\nwith a different tag, or compose it with another component.\n\nAccepts a `ReactElement` or a function that returns the element to render."
        }
    ]
}
