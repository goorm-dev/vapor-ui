{
    "name": "Textarea",
    "props": [
        {
            "name": "autoResize",
            "type": [
                "boolean"
            ],
            "required": false,
            "defaultValue": "false"
        },
        {
            "name": "invalid",
            "type": [
                "boolean"
            ],
            "required": false,
            "defaultValue": "false"
        },
        {
            "name": "size",
            "type": [
                "sm",
                "md",
                "lg",
                "xl"
            ],
            "required": false,
            "defaultValue": "md"
        },
        {
            "name": "defaultValue",
            "type": [
                "string"
            ],
            "required": false,
            "description": "textarea의 기본값입니다. 비제어 방식으로 사용할 때 씁니다.",
            "defaultValue": ""
        },
        {
            "name": "onValueChange",
            "type": [
                "(value: string, event: Textarea.ChangeEventDetails) => void"
            ],
            "required": false,
            "description": "textarea의 값이 변경될 때 호출되는 이벤트 핸들러입니다."
        },
        {
            "name": "value",
            "type": [
                "string"
            ],
            "required": false,
            "description": "textarea의 값입니다. 제어 방식으로 사용할 때 씁니다."
        },
        {
            "name": "className",
            "type": [
                "string | ((state: TextareaState) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "style",
            "type": [
                "CSSProperties | ((state: TextareaState) => (CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: TextareaState) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
