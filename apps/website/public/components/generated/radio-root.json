{
    "name": "RadioRoot",
    "props": [
        {
            "name": "value",
            "type": [
                "unknown"
            ],
            "required": true,
            "description": "그룹 내에서 radio를 식별하는 고유한 값입니다."
        },
        {
            "name": "invalid",
            "type": [
                "boolean"
            ],
            "required": false,
            "defaultValue": "false"
        },
        {
            "name": "size",
            "type": [
                "md",
                "lg"
            ],
            "required": false,
            "defaultValue": "md"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Radio.Root.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "disabled",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "컴포넌트가 사용자 상호작용을 무시하는지 여부입니다."
        },
        {
            "name": "inputRef",
            "type": [
                "Ref<HTMLInputElement>"
            ],
            "required": false,
            "description": "숨겨진 input 요소에 접근하기 위한 ref입니다."
        },
        {
            "name": "nativeButton",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "`render` prop으로 요소를 대체할 때 컴포넌트가 네이티브 `<button>` 요소를 렌더링하는지 여부입니다.\n렌더링되는 요소가 네이티브 버튼이라면 `true`로 설정하세요."
        },
        {
            "name": "readOnly",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "사용자가 라디오 버튼을 선택할 수 없어야 하는지 여부입니다."
        },
        {
            "name": "required",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "폼을 제출하기 전에 사용자가 반드시 값을 선택해야 하는지 여부입니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: Radio.Root.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Radio.Root.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
