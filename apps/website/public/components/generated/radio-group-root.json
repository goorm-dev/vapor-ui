{
    "name": "RadioGroupRoot",
    "props": [
        {
            "name": "size",
            "type": [
                "md",
                "lg"
            ],
            "required": false,
            "defaultValue": "md"
        },
        {
            "name": "defaultValue",
            "type": [
                "unknown"
            ],
            "required": false,
            "description": "처음에 선택되어야 하는 라디오 버튼의 제어되지 않는 값입니다.\n\n제어되는 라디오 그룹을 렌더링하려면 `value` prop을 대신 사용합니다."
        },
        {
            "name": "onValueChange",
            "type": [
                "(value: unknown, eventDetails: RadioGroup.Root.ChangeEventDetails) => void"
            ],
            "required": false,
            "description": "값이 변경될 때 호출되는 콜백입니다."
        },
        {
            "name": "value",
            "type": [
                "unknown"
            ],
            "required": false,
            "description": "현재 선택되어야 하는 라디오 항목의 제어되는 값입니다.\n\n제어되지 않는 라디오 그룹을 렌더링하려면 `defaultValue` prop을 대신 사용하세요."
        },
        {
            "name": "className",
            "type": [
                "string | ((state: RadioGroup.Root.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "invalid",
            "type": [
                "boolean"
            ],
            "required": false
        },
        {
            "name": "disabled",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "컴포넌트가 사용자 상호작용을 무시하는지 여부입니다."
        },
        {
            "name": "form",
            "type": [
                "string"
            ],
            "required": false,
            "description": "radio input을 소유하는 폼을 식별합니다.\n라디오 그룹이 폼 외부에 렌더링될 때 유용합니다."
        },
        {
            "name": "inputRef",
            "type": [
                "Ref<HTMLInputElement>"
            ],
            "required": false,
            "description": "숨겨진 input 요소에 접근하기 위한 ref입니다."
        },
        {
            "name": "name",
            "type": [
                "string"
            ],
            "required": false,
            "description": "폼이 제출될 때 해당 필드를 식별합니다."
        },
        {
            "name": "readOnly",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "사용자가 그룹 내의 다른 라디오 버튼을 선택할 수 없어야 하는지 여부입니다."
        },
        {
            "name": "required",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "폼을 제출하기 전에 사용자가 반드시 값을 선택해야 하는지 여부입니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: RadioGroup.Root.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: RadioGroup.Root.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
