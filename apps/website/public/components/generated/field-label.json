{
    "name": "FieldLabel",
    "props": [
        {
            "name": "foreground",
            "type": [
                "hint",
                "normal",
                "white",
                "primary-100",
                "primary-200",
                "primary",
                "secondary-100",
                "secondary-200",
                "secondary",
                "success-100",
                "success-200",
                "success",
                "warning-100",
                "warning-200",
                "warning",
                "danger-100",
                "danger-200",
                "danger",
                "hint-100",
                "hint-200",
                "contrast-100",
                "contrast-200",
                "contrast",
                "primary-strong",
                "success-strong",
                "warning-strong",
                "danger-strong",
                "normal-100",
                "normal-200",
                "inverse",
                "staticWhite",
                "staticBlack"
            ],
            "required": false,
            "defaultValue": "secondary"
        },
        {
            "name": "typography",
            "type": [
                "body1",
                "display1",
                "display2",
                "display3",
                "display4",
                "heading1",
                "heading2",
                "heading3",
                "heading4",
                "heading5",
                "heading6",
                "subtitle1",
                "subtitle2",
                "body2",
                "body3",
                "body4",
                "code1",
                "code2"
            ],
            "required": false,
            "defaultValue": "body2"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Field.Label.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "nativeLabel",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "`render` prop으로 요소를 대체할 때 컴포넌트가 네이티브 `<label>` 요소를 렌더링하는지 여부입니다.\n렌더링되는 요소가 label이 아니라면(예: `<div>`) `false`로 설정하세요.\n\n이는 `<button>` 컨트롤(`<Select.Trigger>`, `<Combobox.Trigger>` 등)에서 label 동작이 상속되는 것을 피하는 데 유용합니다. label에 마우스를 올릴 때 버튼에 `:hover`가 적용되는 것을 피하고, label 클릭이 버튼에서 발생하는 것을 방지하는 것도 여기에 포함됩니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: Field.Label.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Field.Label.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
