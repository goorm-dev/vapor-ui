{
    "name": "ToolbarGroup",
    "props": [
        {
            "name": "className",
            "type": [
                "string | ((state: Toolbar.Group.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "disabled",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "`true`이면 그룹의 모든 툴바 항목이 비활성화됩니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: Toolbar.Group.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Toolbar.Group.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
