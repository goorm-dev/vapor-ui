{
    "name": "Text",
    "props": [
        {
            "name": "foreground",
            "type": [
                "hint",
                "normal",
                "white",
                "primary-100",
                "primary-200",
                "primary",
                "secondary-100",
                "secondary-200",
                "secondary",
                "success-100",
                "success-200",
                "success",
                "warning-100",
                "warning-200",
                "warning",
                "danger-100",
                "danger-200",
                "danger",
                "hint-100",
                "hint-200",
                "contrast-100",
                "contrast-200",
                "contrast",
                "primary-strong",
                "success-strong",
                "warning-strong",
                "danger-strong",
                "normal-100",
                "normal-200",
                "inverse",
                "staticWhite",
                "staticBlack"
            ],
            "required": false,
            "defaultValue": "normal"
        },
        {
            "name": "typography",
            "type": [
                "body1",
                "display1",
                "display2",
                "display3",
                "display4",
                "heading1",
                "heading2",
                "heading3",
                "heading4",
                "heading5",
                "heading6",
                "subtitle1",
                "subtitle2",
                "body2",
                "body3",
                "body4",
                "code1",
                "code2"
            ],
            "required": false,
            "defaultValue": "body1"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Text.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "style",
            "type": [
                "CSSProperties | ((state: Text.State) => (CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Text.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
