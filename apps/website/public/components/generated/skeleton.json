{
    "name": "Skeleton",
    "description": "콘텐츠가 로딩 중임을 나타내는 placeholder 요소입니다. `<div>` 요소를 렌더링합니다.",
    "props": [
        {
            "name": "animation",
            "type": [
                "none",
                "shimmer",
                "pulse"
            ],
            "required": false,
            "description": "스켈레톤의 애니메이션 스타일을 제어합니다.",
            "defaultValue": "shimmer"
        },
        {
            "name": "shape",
            "type": [
                "square",
                "rounded"
            ],
            "required": false,
            "description": "스켈레톤의 border radius를 제어합니다.",
            "defaultValue": "rounded"
        },
        {
            "name": "size",
            "type": [
                "sm",
                "md",
                "lg",
                "xl"
            ],
            "required": false,
            "description": "스켈레톤의 높이를 제어합니다.",
            "defaultValue": "md"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Skeleton.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "style",
            "type": [
                "CSSProperties | ((state: Skeleton.State) => (CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Skeleton.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
