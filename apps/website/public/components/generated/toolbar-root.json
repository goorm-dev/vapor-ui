{
    "name": "ToolbarRoot",
    "props": [
        {
            "name": "size",
            "type": [
                "sm",
                "md",
                "lg",
                "xl"
            ],
            "required": false
        },
        {
            "name": "variant",
            "type": [
                "outline",
                "ghost"
            ],
            "required": false,
            "defaultValue": "outline"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Toolbar.Root.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 CSS 클래스이거나, 컴포넌트의 상태에 따라 클래스를 반환하는 함수입니다."
        },
        {
            "name": "disabled",
            "type": [
                "boolean"
            ],
            "required": false
        },
        {
            "name": "loopFocus",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "`true`이면 키보드 내비게이션 사용 시 툴바의 끝에 도달했을 때 포커스가 반대쪽 끝으로 순환합니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: Toolbar.Root.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수입니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Toolbar.Root.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 대체하거나 다른 컴포넌트와 합성할 수 있게 합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ]
}
