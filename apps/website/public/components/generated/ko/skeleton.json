{
    "name": "Skeleton",
    "description": "콘텐츠가 로딩 중임을 나타내는 플레이스홀더 요소입니다. `<div>` 요소를 렌더링합니다.",
    "props": [
        {
            "name": "animation",
            "type": [
                "none",
                "shimmer",
                "pulse"
            ],
            "required": false,
            "description": "Skeleton의 애니메이션 스타일을 설정합니다.",
            "defaultValue": "shimmer"
        },
        {
            "name": "shape",
            "type": [
                "square",
                "rounded"
            ],
            "required": false,
            "description": "Skeleton의 테두리 반경을 설정합니다.",
            "defaultValue": "rounded"
        },
        {
            "name": "size",
            "type": [
                "sm",
                "md",
                "lg",
                "xl"
            ],
            "required": false,
            "description": "Skeleton의 높이를 설정합니다.",
            "defaultValue": "md"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Skeleton.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용할 CSS 클래스를 지정합니다. 컴포넌트의 상태를 기반으로 클래스를 반환하는 함수도 사용할 수 있습니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Skeleton.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 교체하거나 다른 컴포넌트와 합성할 때 사용합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 전달할 수 있습니다."
        }
    ]
}
