{
    "name": "TextInput",
    "props": [
        {
            "name": "invalid",
            "type": [
                "boolean"
            ],
            "required": false,
            "defaultValue": "false"
        },
        {
            "name": "size",
            "type": [
                "sm",
                "md",
                "lg",
                "xl"
            ],
            "required": false,
            "defaultValue": "md"
        },
        {
            "name": "defaultValue",
            "type": [
                "string"
            ],
            "required": false,
            "description": "input의 기본값을 지정합니다. 비제어 방식으로 사용할 때 설정합니다.",
            "defaultValue": ""
        },
        {
            "name": "onValueChange",
            "type": [
                "(value: string, event: TextInput.ChangeEventDetails) => void"
            ],
            "required": false,
            "description": "input의 선택된 값이 변경될 때 호출되는 이벤트 핸들러입니다."
        },
        {
            "name": "value",
            "type": [
                "string"
            ],
            "required": false,
            "description": "input의 값을 지정합니다. 제어 방식으로 사용할 때 설정합니다."
        },
        {
            "name": "className",
            "type": [
                "string | ((state: TextInput.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용할 CSS 클래스를 지정합니다. 컴포넌트의 상태를 기반으로 클래스를 반환하는 함수도 사용할 수 있습니다."
        },
        {
            "name": "type",
            "type": [
                "search",
                "text",
                "tel",
                "url",
                "email",
                "password"
            ],
            "required": false,
            "description": "input 요소의 타입을 지정합니다. 입력할 수 있는 데이터의 종류를 결정합니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: TextInput.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용할 스타일을 지정합니다. 컴포넌트의 상태를 기반으로 스타일 객체를 반환하는 함수도 사용할 수 있습니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: TextInput.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 교체하거나 다른 컴포넌트와 합성할 때 사용합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 전달할 수 있습니다."
        }
    ]
}
