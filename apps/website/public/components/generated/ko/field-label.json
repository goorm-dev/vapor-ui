{
    "name": "FieldLabel",
    "props": [
        {
            "name": "foreground",
            "type": [
                "white",
                "inverse",
                "primary-100",
                "primary-200",
                "secondary-100",
                "success-100",
                "success-200",
                "warning-100",
                "warning-200",
                "danger-100",
                "danger-200",
                "hint-100",
                "hint-200",
                "contrast-100",
                "contrast-200",
                "secondary-200",
                "normal-100",
                "normal-200"
            ],
            "required": false,
            "defaultValue": "normal-100"
        },
        {
            "name": "typography",
            "type": [
                "body1",
                "display1",
                "display2",
                "display3",
                "display4",
                "heading1",
                "heading2",
                "heading3",
                "heading4",
                "heading5",
                "heading6",
                "subtitle1",
                "subtitle2",
                "body2",
                "body3",
                "body4",
                "code1",
                "code2"
            ],
            "required": false,
            "defaultValue": "body2"
        },
        {
            "name": "className",
            "type": [
                "string | ((state: Field.Label.State) => (string | undefined))"
            ],
            "required": false,
            "description": "요소에 적용할 CSS 클래스를 지정합니다. 컴포넌트의 상태를 기반으로 클래스를 반환하는 함수도 사용할 수 있습니다."
        },
        {
            "name": "nativeLabel",
            "type": [
                "boolean"
            ],
            "required": false,
            "description": "`render` prop으로 대체할 때 컴포넌트가 네이티브 `<label>` 요소를 렌더링할지 여부를 지정합니다.\n렌더링되는 요소가 label이 아닌 경우(예: `<div>`) `false`로 설정하십시오.\n\n이 옵션은 `<button>` 컨트롤(예: `<Select.Trigger>`, `<Combobox.Trigger>`)에서 label 동작이 상속되는 것을 방지할 때 유용합니다. 레이블에 호버할 때 버튼에 `:hover`가 적용되는 현상이나, 레이블 클릭이 버튼에 전달되는 현상을 방지할 수 있습니다."
        },
        {
            "name": "style",
            "type": [
                "React.CSSProperties | ((state: Field.Label.State) => (React.CSSProperties | undefined))"
            ],
            "required": false,
            "description": "요소에 적용할 스타일을 지정합니다. 컴포넌트의 상태를 기반으로 스타일 객체를 반환하는 함수도 사용할 수 있습니다."
        },
        {
            "name": "render",
            "type": [
                "ReactElement | ((props: HTMLProps, state: Field.Label.State) => ReactElement)"
            ],
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 교체하거나 다른 컴포넌트와 합성할 때 사용합니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 전달할 수 있습니다."
        }
    ]
}
