{
    "name": "ToastObject",
    "description": "`useToastManager` 또는 `toastManager`의 `add`, `update`, `promise`에 전달하는 Toast 하나의 옵션.",
    "props": [
        {
            "name": "id",
            "type": ["string"],
            "detailedType": "string | undefined",
            "required": false,
            "description": "Toast의 고유 식별자. 생략하면 자동으로 생성됩니다."
        },
        {
            "name": "title",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "Toast의 제목."
        },
        {
            "name": "description",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "Toast의 설명."
        },
        {
            "name": "colorPalette",
            "type": ["success", "danger", "info"],
            "detailedType": "\"success\" | \"danger\" | \"info\" | undefined",
            "required": false,
            "description": "Toast의 컬러 팔레트. 기본 아이콘도 이 값으로 정해집니다.",
            "defaultValue": "info"
        },
        {
            "name": "icon",
            "type": ["ReactElement"],
            "detailedType": "ReactElement | undefined",
            "required": false,
            "description": "Toast에 표시되는 아이콘. `colorPalette`의 기본 아이콘을 대체합니다."
        },
        {
            "name": "close",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "닫기 버튼을 표시할지 여부.",
            "defaultValue": "true"
        },
        {
            "name": "actionProps",
            "type": ["ActionProps"],
            "detailedType": "ActionProps | undefined",
            "required": false,
            "description": "`children`, `onClick` 등 액션 버튼의 props. Button의 `colorPalette`, `size`, `variant`도 받으며, `colorPalette`의 기본값은 `secondary`입니다. 이 값을 설정한 경우에만 액션 버튼이 표시됩니다."
        },
        {
            "name": "timeout",
            "type": ["number"],
            "detailedType": "number | undefined",
            "required": false,
            "description": "Toast가 저절로 닫히기까지의 시간(밀리초). `0`이면 닫을 때까지 열려 있습니다.",
            "defaultValue": "5000"
        },
        {
            "name": "priority",
            "type": ["low", "high"],
            "detailedType": "\"low\" | \"high\" | undefined",
            "required": false,
            "description": "보조기술이 Toast를 얼마나 긴급하게 알리는지. `low`는 현재 음성이 끝날 때까지 기다리고, `high`는 현재 음성을 중단시킵니다.",
            "defaultValue": "low"
        },
        {
            "name": "onClose",
            "type": ["function"],
            "detailedType": "(() => void) | undefined",
            "required": false,
            "description": "Toast가 닫힐 때 호출됩니다."
        },
        {
            "name": "onRemove",
            "type": ["function"],
            "detailedType": "(() => void) | undefined",
            "required": false,
            "description": "닫힘 애니메이션이 끝나 Toast가 제거될 때 호출됩니다."
        },
        {
            "name": "data",
            "type": ["object"],
            "detailedType": "Data | undefined",
            "required": false,
            "description": "Toast의 커스텀 데이터. 타입은 `add`의 `Data` 타입 매개변수입니다."
        }
    ]
}
