{
    "name": "Skeleton",
    "description": "콘텐츠를 불러오는 중임을 나타내는 플레이스홀더 요소. `<div>` 요소로 렌더링됩니다.",
    "props": [
        {
            "name": "animation",
            "type": ["none", "shimmer", "pulse"],
            "detailedType": "\"none\" | \"shimmer\" | \"pulse\" | undefined",
            "required": false,
            "description": "Skeleton이 로딩 중임을 보여주는 애니메이션.",
            "defaultValue": "shimmer"
        },
        {
            "name": "shape",
            "type": ["square", "rounded"],
            "detailedType": "\"square\" | \"rounded\" | undefined",
            "required": false,
            "description": "Skeleton의 모서리 스타일.",
            "defaultValue": "rounded"
        },
        {
            "name": "size",
            "type": ["sm", "md", "lg", "xl"],
            "detailedType": "\"sm\" | \"md\" | \"lg\" | \"xl\" | undefined",
            "required": false,
            "description": "Skeleton의 크기. 높이를 결정합니다.",
            "defaultValue": "md"
        },
        {
            "name": "className",
            "type": ["string", "function"],
            "detailedType": "string | ((state: Skeleton.State) => (string | undefined)) | undefined",
            "required": false,
            "description": "요소에 적용되는 CSS 클래스. 또는 컴포넌트의 상태에 따라 클래스를 반환하는 함수."
        },
        {
            "name": "style",
            "type": ["CSSProperties", "function"],
            "detailedType": "CSSProperties | ((state: Skeleton.State) => (CSSProperties | undefined)) | undefined",
            "required": false,
            "description": "요소에 적용되는 스타일. 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수."
        },
        {
            "name": "render",
            "type": ["ReactElement", "function"],
            "detailedType": "ReactElement | ((props: HTMLProps, state: Skeleton.State) => ReactElement) | undefined",
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 교체하거나 다른 컴포넌트와 합성할 수 있습니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ],
    "typeRefs": {
        "Skeleton.State": "{\n\n}"
    }
}
