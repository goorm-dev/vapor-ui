{
    "name": "ProgressBarRoot",
    "description": "시작과 끝이 있는 작업이 얼마나 진행되었는지 보여줍니다. 디스크 사용량이나 점수처럼 고정된 척도의 측정값에는 대신 `Meter`를 사용하세요. `<div>` 요소로 렌더링됩니다.",
    "props": [
        {
            "name": "value",
            "type": ["number", "null"],
            "detailedType": "number | null",
            "required": true,
            "description": "현재 값. `null`이면 컴포넌트는 indeterminate 상태가 됩니다."
        },
        {
            "name": "size",
            "type": ["sm", "md", "lg"],
            "detailedType": "\"sm\" | \"md\" | \"lg\" | undefined",
            "required": false,
            "description": "트랙의 크기. 높이를 결정합니다.",
            "defaultValue": "md"
        },
        {
            "name": "type",
            "type": ["default", "error"],
            "detailedType": "\"default\" | \"error\" | undefined",
            "required": false,
            "description": "설명 텍스트의 톤.",
            "defaultValue": "default"
        },
        {
            "name": "className",
            "type": ["string", "function"],
            "detailedType": "string | ((state: ProgressBar.Root.State) => (string | undefined)) | undefined",
            "required": false,
            "description": "요소에 적용되는 CSS 클래스 또는 컴포넌트의 상태에 따라 클래스를 반환하는 함수."
        },
        {
            "name": "style",
            "type": ["React.CSSProperties", "function"],
            "detailedType": "React.CSSProperties | ((state: ProgressBar.Root.State) => (React.CSSProperties | undefined)) | undefined",
            "required": false,
            "description": "요소에 적용되는 스타일 또는 컴포넌트의 상태에 따라 스타일 객체를 반환하는 함수."
        },
        {
            "name": "aria-valuetext",
            "type": ["string"],
            "detailedType": "string | undefined",
            "required": false,
            "description": "프로그레스 바의 현재 값인 `aria-valuenow`를 사용자가 이해하기 쉽게 나타내는 문자열."
        },
        {
            "name": "format",
            "type": ["Intl.NumberFormatOptions"],
            "detailedType": "Intl.NumberFormatOptions | undefined",
            "required": false,
            "description": "값을 포맷하는 옵션."
        },
        {
            "name": "getAriaValueText",
            "type": ["function"],
            "detailedType": "((formattedValue: string, value: number | null) => string) | undefined",
            "required": false,
            "description": "프로그레스 바의 현재 값을 사람이 읽을 수 있는 대체 텍스트로 나타내는 문자열을 반환하는 함수를 받습니다."
        },
        {
            "name": "locale",
            "type": ["Intl.LocalesArgument"],
            "detailedType": "Intl.LocalesArgument",
            "required": false,
            "description": "값을 포맷할 때 `Intl.NumberFormat`이 사용하는 로케일.\n기본값은 사용자의 런타임 로케일입니다."
        },
        {
            "name": "max",
            "type": ["number"],
            "detailedType": "number | undefined",
            "required": false,
            "description": "최댓값.",
            "defaultValue": "100"
        },
        {
            "name": "min",
            "type": ["number"],
            "detailedType": "number | undefined",
            "required": false,
            "description": "최솟값.",
            "defaultValue": "0"
        },
        {
            "name": "render",
            "type": ["ReactElement", "function"],
            "detailedType": "ReactElement | ((props: HTMLProps, state: ProgressBar.Root.State) => ReactElement) | undefined",
            "required": false,
            "description": "컴포넌트의 HTML 요소를 다른 태그로 바꾸거나 다른 컴포넌트와 합성할 수 있습니다.\n\n`ReactElement` 또는 렌더링할 요소를 반환하는 함수를 받습니다."
        }
    ],
    "typeRefs": {
        "ProgressBar.Root.State": "{\n  status: \"indeterminate\" | \"progressing\" | \"complete\";\n}"
    }
}
