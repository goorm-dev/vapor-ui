{
    "name": "MenuItem",
    "props": [
        {
            "name": "label",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": true,
            "description": "항목의 텍스트 라벨."
        },
        {
            "name": "onClick",
            "type": ["function"],
            "detailedType": "((event: BaseUIEvent<React.MouseEvent<HTMLDivElement, MouseEvent>>) => void) | undefined",
            "required": true,
            "description": "항목 클릭 시 호출되는 이벤트 핸들러."
        },
        {
            "name": "description",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "항목의 동작을 설명하는 텍스트."
        },
        {
            "name": "isDisabled",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "아이템을 비활성화한다. 비활성화된 아이템은 클릭 시 액션을 실행하지 않는다."
        },
        {
            "name": "leading",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "항목 좌측에 표시되는 요소. 주로 아이콘을 배치한다."
        },
        {
            "name": "trailing",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "항목 우측에 표시되는 요소. 단축키나 보조 아이콘 등을 배치한다."
        },
        {
            "name": "variant",
            "type": ["critical", "default"],
            "detailedType": "\"critical\" | \"default\" | undefined",
            "required": false,
            "description": "메뉴 아이템의 시각적 위계를 결정한다."
        }
    ]
}
