{
    "name": "MenuRoot",
    "props": [
        {
            "name": "children",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": true,
            "description": "메뉴 내부에 표시할 요소."
        },
        {
            "name": "defaultOpen",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "마운트 시 초기 열림 여부(비제어)."
        },
        {
            "name": "onOpenChange",
            "type": ["function"],
            "detailedType": "((open: boolean, eventDetails: MenuRootChangeEventDetails) => void) | undefined",
            "required": false,
            "description": "열림 상태 변경 콜백. 트리거·오버레이 클릭·ESC 등 모든 열림/닫힘 경로에서 호출된다."
        },
        {
            "name": "open",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "메뉴 열림 상태(제어). 사용자 액션에 반응한 상태 변경을 외부에서 추적해야 할 때 사용한다.\n상태의 변경을 추적할 필요가 없다면 defaultOpen을 사용한다."
        },
        {
            "name": "actionsRef",
            "type": ["React.RefObject<Menu.Root.Actions | null>"],
            "detailedType": "React.RefObject<Menu.Root.Actions | null> | undefined",
            "required": false,
            "description": "메뉴를 프로그래밍적으로 조작하기 위한 ref를 지정한다."
        },
        {
            "name": "align",
            "type": ["center", "end", "start"],
            "detailedType": "\"center\" | \"end\" | \"start\" | undefined",
            "required": false,
            "description": "트리거와 팝업의 정렬 기준."
        },
        {
            "name": "container",
            "type": [
                "HTMLElement",
                "ShadowRoot",
                "React.RefObject<HTMLElement | ShadowRoot | null>",
                "null"
            ],
            "detailedType": "HTMLElement | ShadowRoot | React.RefObject<HTMLElement | ShadowRoot | null> | null | undefined",
            "required": false,
            "description": "Portal 대상 컨테이너. SSR·shadow DOM·특정 스택 컨텍스트에서 팝업 위치 제어가 필요할 때만 지정한다."
        },
        {
            "name": "modal",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "메뉴가 모달로 동작할지 여부. `true`이면 열려 있는 동안 배경 인터랙션이 차단된다.\n최상위 `Menu.Root`에서만 유효하며, 중첩된 `Menu.Root`에서는 무시된다."
        },
        {
            "name": "side",
            "type": ["bottom", "left", "right", "top", "inline-end", "inline-start"],
            "detailedType": "\"bottom\" | \"left\" | \"right\" | \"top\" | \"inline-end\" | \"inline-start\" | undefined",
            "required": false,
            "description": "트리거를 기준으로 팝업이 열리는 방향.\n최상위 `Menu.Root`에서는 `\"bottom\"`, 중첩 `Menu.Root` (SubmenuItem 아래)에서는 `\"right\"`를 기본값으로 갖는다."
        },
        {
            "name": "trigger",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "메뉴를 여는 진입 요소.\n- 최상위 `Menu.Root`에서는 `Trigger`로 렌더링된다.\n- 다른 `Menu.Root` 하위에서 사용되면 부모 메뉴의 아이템으로 동작하는 `SubmenuTrigger`로 렌더링된다."
        }
    ],
    "typeRefs": {
        "Menu.Root.Actions": "{\n  unmount: () => void;\n  close: () => void;\n}"
    }
}
