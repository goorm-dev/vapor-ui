{
    "name": "Dialog",
    "description": "페이지 위에 창을 띄워 사용자를 중요한 정보에 집중시키거나, 특정 작업을 수행하도록 강제하는 Dialog의 루트 요소",
    "props": [
        {
            "name": "ariaLabels",
            "type": ["AriaLabels"],
            "detailedType": "AriaLabels",
            "required": true,
            "description": "다이얼로그 내부 요소의 aria-label을 지정한다."
        },
        {
            "name": "title",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": true,
            "description": "다이얼로그의 목적을 한 문장으로 전달한다."
        },
        {
            "name": "defaultOpen",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "마운트 시 초기 열림 여부(비제어)."
        },
        {
            "name": "onOpenChange",
            "type": ["function"],
            "detailedType": "((open: boolean, eventDetails: DialogRootChangeEventDetails) => void) | undefined",
            "required": false,
            "description": "열림 상태 변경 콜백. 트리거·오버레이·ESC 등 모든 닫힘 경로에서 호출된다."
        },
        {
            "name": "open",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "다이얼로그 열림 상태(제어). 사용자가 결정을 내려야 하는 시점을 외부 상태로 동기화할 때 사용한다.\n상태의 변경을 추적할 필요가 없다면 defaultOpen을 사용한다."
        },
        {
            "name": "action",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "다이얼로그의 주요 액션 요소."
        },
        {
            "name": "actionsRef",
            "type": ["React.RefObject<Dialog.Root.Actions | null>"],
            "detailedType": "React.RefObject<Dialog.Root.Actions | null> | undefined",
            "required": false,
            "description": "다이얼로그를 조작하기 위한 ref를 지정한다."
        },
        {
            "name": "assistive",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "다이얼로그의 보조 액션 요소."
        },
        {
            "name": "children",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "다이얼로그의 본문에 해당한다."
        },
        {
            "name": "container",
            "type": [
                "HTMLElement",
                "ShadowRoot",
                "React.RefObject<HTMLElement | ShadowRoot | null>",
                "null"
            ],
            "detailedType": "HTMLElement | ShadowRoot | React.RefObject<HTMLElement | ShadowRoot | null> | null | undefined",
            "required": false,
            "description": "Portal 대상 컨테이너. SSR·shadow DOM·특정 스택 컨텍스트에서 오버레이 위치 제어가 필요할 때만 지정한다."
        },
        {
            "name": "description",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "결정에 필요한 부가 설명."
        },
        {
            "name": "keepMounted",
            "type": ["boolean"],
            "detailedType": "boolean | undefined",
            "required": false,
            "description": "닫힘 시에도 DOM에 유지할지 여부. 애니메이션/폼 상태 보존이 필요한 경우 true."
        },
        {
            "name": "size",
            "type": ["md", "lg", "xl"],
            "detailedType": "\"md\" | \"lg\" | \"xl\" | undefined",
            "required": false,
            "description": "다이얼로그의 크기를 변경한다."
        },
        {
            "name": "trigger",
            "type": ["ReactNode"],
            "detailedType": "ReactNode",
            "required": false,
            "description": "다이얼로그를 여는 진입 요소."
        }
    ],
    "typeRefs": {
        "Dialog.Root.Actions": "{\n  unmount: () => void;\n  close: () => void;\n}"
    }
}
