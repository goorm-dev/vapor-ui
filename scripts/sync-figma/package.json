{
    "name": "@repo/sync-figma",
    "version": "0.0.1",
    "private": true,
    "description": "Internal CLI scripts for syncing assets from Figma",
    "type": "module",
    "scripts": {
        "format": "prettier --write \"./{commands,src}/**/*.{ts,md}\"",
        "format:check": "prettier --check \"./{commands,src}/**/*.{ts,md}\"",
        "notify:slack": "tsx ./commands/notify-slack.ts",
        "parity:compare": "tsx ./parity/compare.ts",
        "parity:fetch": "tsx --env-file-if-exists=.env ./parity/fetch-baseline.ts",
        "parity:render": "tsx ./parity/render.ts",
        "parity:selfcheck": "tsx ./parity/selfcheck.ts",
        "sync-icons:basic": "TYPE=basic tsx --env-file-if-exists=.env ./commands/sync-icons.ts",
        "sync-icons:symbol": "TYPE=symbol tsx --env-file-if-exists=.env ./commands/sync-icons.ts",
        "test": "vitest --run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/plugin-svgo": "^8.1.0",
        "lodash-es": "^4.18.1",
        "p-limit": "^6.2.0",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.6"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.20.1",
        "@types/pngjs": "^6.0.5",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "pixelmatch": "^7.2.0",
        "playwright": "^1.62.1",
        "pngjs": "^7.0.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tsx": "^4.23.12",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
