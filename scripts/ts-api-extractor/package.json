{
    "name": "@vapor-ui/ts-api-extractor",
    "version": "0.0.1",
    "private": true,
    "description": "TypeScript AST-based API extractor for documentation generation",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "ts-api-extractor": "./dist/cli/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint ./src",
        "test": "vitest --run",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "glob": "^10.5.0",
        "meow": "^14.1.0",
        "ts-morph": "^22.0.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "tsup": "^8.5.1",
        "tsx": "^4.23.13",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "typescript": ">=5.9.3"
    }
}
