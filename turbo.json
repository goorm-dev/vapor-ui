{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "storybook#dev": {
            "dependsOn": ["@vapor-ui/core#build"]
        },
        "website#dev": {
            "dependsOn": [
                "@vapor-ui/core#build",
                "@vapor-ui/icons#build",
                "@vapor-ui/css-generator#build",
                "@vapor-ui/color-generator#build",
                "website#docs:api"
            ],
            "outputs": ["dist/**"]
        },
        "website#start": {
            "dependsOn": ["website#build"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "website#build": {
            "dependsOn": ["^build", "website#docs:api"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "website#docs:api": {
            "inputs": [
                "$TURBO_ROOT$/packages/core/src/**",
                "$TURBO_ROOT$/packages/core/tsconfig.json",
                "$TURBO_ROOT$/scripts/docs-extractor/src/**",
                "content/docs/components/*/index.mdx"
            ],
            "outputs": ["content/docs/components/*/api/*.json"]
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "outputs": [],
            "dependsOn": ["^build"]
        },
        "test:regressions": {
            "dependsOn": ["storybook#build:storybook"],
            "cache": false
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "clean": {
            "cache": false
        },
        "build:storybook": {
            "dependsOn": ["@vapor-ui/core#build", "@vapor-ui/icons#build"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["storybook-static/**"]
        }
    },
    "globalEnv": [
        "NODE_ENV",
        "CI",
        "TEST_URL",
        "PORT",
        "npm_lifecycle_event",
        "COMPONENT",
        "STORYBOOK_SKIP_DOCGEN"
    ],
    "globalPassThroughEnv": ["FIGMA_API_KEY"]
}
